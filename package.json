{
  "name": "multi-agent-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json",
    "browser:install": "node scripts/install-browser.mjs"
  },
  "dependencies": {
    "@openai/agents": "0.21.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
